CATEGORIA = "Subtotal"
) %>%
select(-Margen_bruto_valor, -"Total gastos + sueldos")
fila_resultado_final <- fila_resultado_operativo %>%
select(AÑO, MES, TIENDA, RESULTADO_OPERATIVO = TOTAL) %>%
left_join(fila_total_impuestos %>%
select(AÑO, MES, TIENDA, IMPUESTOS = TOTAL), by = c("AÑO", "MES", "TIENDA")) %>%
mutate(TOTAL = RESULTADO_OPERATIVO - IMPUESTOS) %>%
select(-RESULTADO_OPERATIVO, -IMPUESTOS) %>%
mutate(CONCEPTO = "Resultado final",
CATEGORIA = "Total")
TABLA_PRESUPUESTO <- bind_rows(Tabla_ventas_costo_margen, Tabla_gastos, Tabla_gasto_financiero, Tabla_sueldos_FINAL, fila_resultado_operativo, Tabla_impuestos, fila_resultado_final) %>%
select(-CATEGORIA) %>%
filter(AÑO >= año_minimo & MES <= mes_maximo)
write.xlsx(TABLA_PRESUPUESTO, paste0("Presupuestos tiendas/Tabla presupuestos_", año_minimo, mes_maximo, ".xlsx"))
View(Tabla_gastos)
table(FACTURAS_TIENDAS$ITEM)
#Creo tablas
Gastos_unificados <- FACTURAS_TIENDAS %>%
rename(CONCEPTO = ITEM) %>%
filter(IMPORTE>0) %>%
rename(MES = MES_ASIGNADO) |>
#filter(AÑO >= año_minimo & MES <= mes_maximo) |>
bind_rows(gastos_para_unir, Packaging_AS) |>
group_by(AÑO, MES, TIENDA, CONCEPTO) %>%
summarise(TOTAL = sum(IMPORTE, na.rm = TRUE),
.groups = "drop") |>
# unite(col = "AÑO_MES", AÑO, MES, sep = "-") %>%
# pivot_wider(
#   names_from = AÑO_MES,
#   values_from = IMPORTE,
#   values_fill = 0
# ) |>
mutate(
orden_item = case_when(
CONCEPTO == "ALQUILER" ~ 1,
CONCEPTO == "EXPENSAS" ~ 2,
TRUE ~ 3
)
) |>
arrange(
TIENDA,
orden_item,
CONCEPTO
) |>
select(-orden_item) %>%
mutate(CONCEPTO = case_when(CONCEPTO == "ALQUILER" ~ "Alquiler",
CONCEPTO == "EXPENSAS" ~ "Expensas",
CONCEPTO == "FUMIGACION" ~ "Fumigación",
CONCEPTO == "ALARMA" ~ "Alarma",
CONCEPTO == "EDESUR" ~ "Edesur",
CONCEPTO == "INTERNET" ~ "Internet",
CONCEPTO == "MANTENIMIENTO" ~ "Mantenimiento",
CONCEPTO == "MATAFUEGO" ~ "Matafuegos",
CONCEPTO == "ARQUITECTURA" ~ "Arquitectura",
CONCEPTO == "HONORARIOS" ~ "Honorarios",
CONCEPTO == "MARKETING LUCERO" ~ "Marketing",
CONCEPTO == "SERVICIOS" ~ "Servicios",
TRUE ~ CONCEPTO))
View(Gastos_unificados)
