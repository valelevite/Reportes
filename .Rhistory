Unidades = NA,
Facturación = DESCUENTO_TOTAL,
Participación = NA)
tabla_venta_rubro <- bind_rows(fila_descuento_rubro, tabla_vta_rubro)
tabla_venta_rubro <- bind_rows(totales_venta_rubro, tabla_venta_rubro)
graficos_rubro_unidades <- FACTURAS_MES2 %>%
filter(
FECHA_EMISION >= "2025-01-01",
FECHA_EMISION <= fecha_fin_mes
) %>%
mutate(MES = month(FECHA_EMISION)) %>%
group_by(RUBRO, MES) %>%
summarise(
Unidades = sum(PRODUCTO_CANTIDAD, na.rm = TRUE),
Facturación = sum(PRODUCTO_TOTAL, na.rm = TRUE),
