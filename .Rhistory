) %>%
arrange(
RUBRO,
FAMILIA,
SUBFAMILIA,
tipo_fila,  # 0=productos primero, 1=totales al final
desc(TOTAL)
) %>%
select(-tipo_fila) %>%
mutate(RUBRO = ifelse(str_detect(DESCRIPCION, "^Total"), "", RUBRO),
FAMILIA = ifelse(str_detect(DESCRIPCION, "^Total"), "", FAMILIA),
SUBFAMILIA = ifelse(str_detect(DESCRIPCION, "^Total"), "", SUBFAMILIA))
SKU_FAMILIA_final <- SKU_FAMILIA_final %>%
mutate(CONDICION = ifelse(RUBRO == "OUTLET", "outlet", CONDICION))
#los modelos pueden tener distinto precio por color o por inflación, entonces se muestra el precio unitario calculado Total/venta
Modelos <- SKU_total %>%
filter(PROVEEDOR != "TOTAL" & PROVEEDOR != "DESCUENTO") %>%
group_by(PROVEEDOR, RUBRO, FAMILIA, SUBFAMILIA, DESCRIPCION) %>%
summarise(VENTA = sum(VENTA, na.rm = TRUE), TOTAL = sum(TOTAL, na.rm = TRUE), PRECIO = round(TOTAL/VENTA), STOCK = sum(STOCK, na.rm = TRUE), "D/S" = round(STOCK/VENTA*30)) %>%
# distinct() %>%
arrange(desc(TOTAL)) %>%
ungroup() %>%
relocate(PRECIO, .after = VENTA)
# Creo la fila con el descuento
desc_modelos <- tibble(
PROVEEDOR = "DESCUENTO",
RUBRO = NA,
FAMILIA = NA,
SUBFAMILIA = NA,
DESCRIPCION = NA,
PRECIO = NA,
VENTA = NA,
TOTAL = DESCUENTO_TOTAL,
STOCK = NA,
`D/S` = NA)
# Agregar la fila al inicio del marco de datos
Modelos_desc <- bind_rows(desc_modelos, Modelos)
# Creo la fila con los totales
totales_modelos <- tibble(
PROVEEDOR = "TOTAL",
RUBRO = NA,
FAMILIA = NA,
SUBFAMILIA = NA,
DESCRIPCION = NA,
PRECIO = NA,
VENTA = sum(Modelos$VENTA, na.rm = TRUE),
TOTAL = sum(Modelos$TOTAL, na.rm = TRUE)-DESCUENTO_TOTAL,
STOCK = sum(Modelos$STOCK, na.rm = TRUE),
`D/S` = NA)
# Agregar la fila al inicio del marco de datos
Modelos_total <- bind_rows(totales_modelos, Modelos_desc)
# Ordeno columnas
Modelos_total <- Modelos_total %>%
relocate(PRECIO, .after = VENTA)
#TABLA RUBRO
tabla_vta_rubro <- FACTURAS_MES2 %>%
group_by(RUBRO) %>%
summarise(Unidades = sum(PRODUCTO_CANTIDAD, na.rm = TRUE),
"Facturación" = sum(PRODUCTO_TOTAL, na.rm = TRUE)) %>%
complete(RUBRO = unique(FACTURAS_MES2$RUBRO),  # Lista completa de rubros
fill = list(Unidades = 0, Facturación = 0)) %>%
arrange(desc(Facturación)) %>%
mutate(Participación = round(Facturación/sum(Facturación), digits = 4))
totales_venta_rubro <- tabla_vta_rubro %>%
summarise(RUBRO = "TOTAL",
Unidades = sum(Unidades, na.rm = TRUE),
Facturación = sum(Facturación, na.rm = TRUE)-DESCUENTO_TOTAL,
Participación = 1)
