#Calculo las unidades vendidas por nacionalidad y tienda
NACIONALIDAD_X_UNIDAD_JOYERIA <- FACTURAS_MES2_JOYERIA %>%
group_by(NACIONALIDAD) %>%
summarise("Güemes 2" = sum(if_else(TIENDA== "Güemes 2", PRODUCTO_CANTIDAD, 0), na.rm = TRUE),
"El Solar" = sum(if_else(TIENDA== "El Solar", PRODUCTO_CANTIDAD, 0), na.rm = TRUE),
"San Telmo 2" = sum(if_else(TIENDA== "San Telmo 2", PRODUCTO_CANTIDAD, 0), na.rm = TRUE),
`Total cantidad` = `Güemes 2`+`El Solar` + `San Telmo 2`,
.groups = "drop"
)
fila_total_nacionalidad_unidad_JOYERIA <- tibble(
NACIONALIDAD = "Total general",
`Güemes 2`= sum(NACIONALIDAD_X_UNIDAD_JOYERIA$`Güemes 2`, na.rm = TRUE),
`El Solar` = sum(NACIONALIDAD_X_UNIDAD_JOYERIA$`El Solar`, na.rm = TRUE),
`San Telmo 2` = sum(NACIONALIDAD_X_UNIDAD_JOYERIA$`San Telmo 2`, na.rm = TRUE),
`Total cantidad` = sum(NACIONALIDAD_X_UNIDAD_JOYERIA$`Total cantidad`, na.rm = TRUE))
NACIONALIDAD_X_UNIDAD_TOTAL_JOYERIA <- bind_rows(fila_total_nacionalidad_unidad_JOYERIA, NACIONALIDAD_X_UNIDAD_JOYERIA)
#Calculo la facturación por nacionalidad y tienda
NACIONALIDAD_X_FACTURACION_JOYERIA <- FACTURAS_MES2_JOYERIA %>%
# 1. Nos aseguramos de tener 1 fila por factura
# distinct(TIENDA, NRO_FACTURA, .keep_all = TRUE) %>%
# 2. Sumamos por Nacionalidad y Tienda
group_by(NACIONALIDAD, TIENDA) %>%
summarise(TOTAL = sum(PRODUCTO_TOTAL, na.rm = TRUE), .groups = "drop") %>%
# 3. Pivoteamos para que cada tienda sea una columna
pivot_wider(names_from = TIENDA, values_from = TOTAL, values_fill = 0) %>%
# 4. Sumamos la fila completa para el Total
mutate(`Total facturación` = rowSums(select(., -NACIONALIDAD), na.rm = TRUE))
fila_total_nacionalidad_facturacion_JOYERIA <- tibble(
NACIONALIDAD = "Total general",
`Güemes 2`= sum(NACIONALIDAD_X_FACTURACION_JOYERIA$`Güemes 2`, na.rm = TRUE)-DESCUENTO_X_TIENDA_JOYERIA$DTO_X_TIENDA[DESCUENTO_X_TIENDA_JOYERIA$TIENDA == "Güemes 2"],
`El Solar` = sum(NACIONALIDAD_X_FACTURACION_JOYERIA$`El Solar`, na.rm = TRUE)-DESCUENTO_X_TIENDA_JOYERIA$DTO_X_TIENDA[DESCUENTO_X_TIENDA_JOYERIA$TIENDA == "El Solar"],
`San Telmo 2` = sum(NACIONALIDAD_X_FACTURACION_JOYERIA$`San Telmo 2`, na.rm = TRUE)-DESCUENTO_X_TIENDA_JOYERIA$DTO_X_TIENDA[DESCUENTO_X_TIENDA_JOYERIA$TIENDA == "San Telmo 2"],
`Total facturación` = sum(NACIONALIDAD_X_FACTURACION_JOYERIA$`Total facturación`, na.rm = TRUE)-sum(DESCUENTO_X_TIENDA_JOYERIA$DTO_X_TIENDA))
NACIONALIDAD_X_FACTURACION_TOTAL_JOYERIA <- bind_rows(fila_total_nacionalidad_facturacion_JOYERIA, NACIONALIDAD_X_FACTURACION_JOYERIA)
#Uno las dos tablas (cantidad y facturación)
NACIONALIDAD_ENTERA_JOYERIA <- NACIONALIDAD_X_UNIDAD_TOTAL_JOYERIA %>%
left_join(NACIONALIDAD_X_FACTURACION_TOTAL_JOYERIA, by = "NACIONALIDAD") %>%
arrange(desc(`Total facturación`))
View(NACIONALIDAD_ENTERA_JOYERIA)
Stock <- read_excel(paste0("Stock/Stock_", fecha_stock,".xlsx")) %>%
select(TIENDA = Ubicación, REFERENCIA_INTERNA = "Código de referencia de producto", PRODUCTO= Producto, CANTIDAD = "Cantidad en inventario") |> filter(TIENDA != "WHLUC/Fallado") |>
mutate(TIENDA = case_when(TIENDA == "WHASG/Stock" ~ "AS Güemes",
TIENDA == "WHASS/Stock" ~ "AS San Telmo",
TIENDA == "WHBAS/Barracas" ~ "AS Barracas",
TIENDA == "WHBAS/Reserva" ~ "AS Reserva",
TIENDA == "WHBLU/Stock" ~ "Barracas",
TIENDA == "WHFLO/Stock" ~ "Florida",
TIENDA == "WHFRE/Stock" ~ "French",
TIENDA == "WHGU1/Stock" ~ "Güemes",
TIENDA == "WHGU2/Stock" ~ "Güemes 2",
TIENDA == "WHLUC/Stock" ~ "Florida Depósito",
TIENDA == "WHREC/Stock" ~ "Recoleta",
TIENDA == "WHSOL/Stock" ~ "El Solar",
TIENDA == "WHST1/Stock" ~ "San Telmo 1",
TIENDA == "WHST2/Stock" ~ "San Telmo 2",
TRUE ~ TIENDA))
#Dejo en stock lo que es joyería y cambio a 0 las cantidades en negativo
Stock_JOYERIA <- Stock |>
filter(TIENDA %in% c("Güemes 2", "El Solar", "San Telmo 2", "Florida Depósito", "Barracas"),
!is.na(REFERENCIA_INTERNA)) |>
mutate(CANTIDAD = if_else(CANTIDAD<0, 0, CANTIDAD))
View(Stock_JOYERIA)
#Le agrego las columnas que necesito de los productos
##Primero preparo los datos
Base_para_stock_JOYERIA <- Base_Articulos_Odoo_para_machear |>
select(CODIGO_BARRAS, REFERENCIA_INTERNA, RUBRO, FAMILIA = SUBFAMILIA, MATERIAL, COLOR, TALLE, VARIANTE, MEDIDA, DIAMETRO, GROSOR, PESO)
Stock_con_subfamilia_JOYERIA <- Stock_JOYERIA |>
left_join(Base_para_stock_JOYERIA, by = "REFERENCIA_INTERNA")
View(Stock_con_subfamilia_JOYERIA)
#FIltro bien para quedarme sólo con productos de joyería
Stock_con_subfamilia_JOYERIA <- Stock_JOYERIA |>
left_join(Base_para_stock_JOYERIA, by = "REFERENCIA_INTERNA") |>
filter(FAMILIA %in% c("ANILLOS", "AROS", "CADENAS Y COLLARES", "PULSERAS", "DIJES Y COLGANTES", "ACCESORIOS DE CUERO") |  str_detect(PRODUCTO, "TIENTO CUERO|COLLAR TUBO CUERO|ANILLO|PULSERA|BRAZALETE")) %>%
mutate(FAMILIA = case_when(
RUBRO == "MARRO CHICA" ~ "ACCESORIOS DE CUERO",
TRUE ~ FAMILIA)) #Le agrego la categoría a lo que es cuero dentro de lo que va a llamarse FAMILIA en el reporte
#Le agrego los precios desde la lista de precios de Odoo
Precios <- read_excel(paste0("Lista_precios/Lista_precios_", fecha_precios, ".xlsx")) |>
rename(PRODUCTO = "Reglas de lista de precios/Variante", PRECIO_SIN_IMP = "Reglas de lista de precios/Precio fijo") |>
mutate(PRECIO = round(PRECIO_SIN_IMP*1.21)) |>
mutate(REFERENCIA_INTERNA = str_extract(PRODUCTO, "(?<=\\[)\\d{6}(?=\\])")) %>%
select(-PRECIO_SIN_IMP, -PRODUCTO)
Stock_con_precios_JOYERIA <- Stock_con_subfamilia_JOYERIA |>
left_join(Precios, by = "REFERENCIA_INTERNA")
REVISAR_STOCK_SIN_PRECIO_JOYERIA <- Stock_con_precios_JOYERIA %>%
filter(is.na(PRECIO)) #para eliminar las filas de productos que no están a la venta
View(REVISAR_STOCK_SIN_PRECIO_JOYERIA)
View(REVISAR_STOCK_SIN_PRECIO_JOYERIA)
STOCK_TIENDA_JOYERIA <-  Stock_con_precios_JOYERIA %>%
mutate(TOTAL = PRECIO*CANTIDAD) |>
select(FAMILIA, TIENDA, TOTAL) %>%
group_by(FAMILIA, TIENDA) %>%
summarise(VALOR_STOCK = sum(TOTAL, na.rm = TRUE))
