SKU_SUBFAMILIA_JOYERIA_final$DESCRIPCION, "^Total")) + 1
num_cols_fam <- which(names(SKU_SUBFAMILIA_JOYERIA_final) %in%
c("VENTA", "PRECIO", "TOTAL", "STOCK", "D/S"))
apply_table_styles(wb, ws, SKU_SUBFAMILIA_JOYERIA_final,
start_row = 1, start_col = 1,
total_rows = total_rows_fam,
num_cols   = num_cols_fam)
setColWidths(wb, ws, cols = 1:2, widths = 22)
setColWidths(wb, ws, cols = 3:ncol(SKU_SUBFAMILIA_JOYERIA_final), widths = 13)
freezePane(wb, ws, firstActiveRow = 2)
addFilter(wb, ws, row = 1, cols = 1:ncol(SKU_SUBFAMILIA_JOYERIA_final))
addWorksheet(wb, "Modelos", gridLines = FALSE)
