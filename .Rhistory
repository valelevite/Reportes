setColWidths(wb, ws, cols = 8:9, widths = 14)
setColWidths(wb, ws, cols = 10, widths = 12)
# Gráfico stacked bar: participación dentro de cada subfamilia
datos_prov_chart <- PROVEEDOR_SUBFAMILIAS_TOTAL_JOYERIA %>%
filter(SUBFAMILIA != "TOTAL") %>%
group_by(SUBFAMILIA) %>%
mutate(Part_dentro_sf = Facturación / sum(Facturación, na.rm = TRUE)) %>%
ungroup()
# Quedarse sólo con los top 7 proveedores; el resto = "Otros"
top_provs <- datos_prov_chart %>%
group_by(PROVEEDOR) %>%
summarise(tot = sum(Facturación, na.rm = TRUE)) %>%
arrange(desc(tot)) %>%
slice_head(n = 7) %>%
pull(PROVEEDOR)
datos_prov_chart2 <- datos_prov_chart %>%
mutate(PROV_LABEL = if_else(PROVEEDOR %in% top_provs, PROVEEDOR, "Otros"))
# Ordenar subfamilias por facturación total descendente (mayor abajo en Y)
orden_sf_prov <- datos_prov_chart %>%
group_by(SUBFAMILIA) %>%
summarise(tot_sf = sum(Facturación, na.rm = TRUE)) %>%
arrange(tot_sf) %>%            # sin desc() → el mayor queda arriba en ggplot
pull(SUBFAMILIA)
datos_prov_chart2 <- datos_prov_chart2 %>%
mutate(SUBFAMILIA = factor(SUBFAMILIA, levels = orden_sf_prov))
# Orden de proveedores dentro de cada barra: mayor facturación a la izquierda
# rev() porque geom_col apila en orden del factor y el primero queda a la izquierda
prov_order <- datos_prov_chart2 %>%
group_by(PROV_LABEL) %>%
summarise(tot = sum(Facturación, na.rm = TRUE)) %>%
arrange(desc(tot)) %>%
pull(PROV_LABEL)
datos_prov_chart2 <- datos_prov_chart2 %>%
mutate(
PROV_LABEL = str_trunc(PROV_LABEL, width = 28, ellipsis = "…"),
PROV_LABEL = factor(PROV_LABEL, levels = str_trunc(prov_order, width = 28, ellipsis = "…"))
)
p_prov <- ggplot(datos_prov_chart2,
aes(x = Part_dentro_sf, y = SUBFAMILIA, fill = PROV_LABEL)) +
geom_col(position = "stack", width = 0.65) +
scale_x_continuous(labels = percent,
expand = expansion(mult = c(0, 0.02))) +
scale_fill_brewer(palette = "Set2", name = "Proveedor") +
labs(title = "Participación por Proveedor dentro de cada Subfamilia") +
tema_reporte() +
theme(
legend.position = "right",
legend.text     = element_text(size = 8),
legend.key.size = unit(0.4, "cm"),
legend.title    = element_text(size = 9, face = "bold")
)
img_h_prov <- max(4, length(orden_sf_prov) * 0.55)
img_prov   <- save_plot_tmp(p_prov, width = 11, height = img_h_prov)
insertImage(wb, ws, img_prov, startRow = 1, startCol = 1,
width = 11, height = img_h_prov, units = "in")
# Tabla detalle debajo del gráfico
data_start_prov <- ceiling(img_h_prov / 0.21) + 3
writeData(wb, ws, "Detalle por subfamilia y proveedor",
startRow = data_start_prov - 1, startCol = 1)
addStyle(wb, ws, st_titulo_bloque,
rows = data_start_prov - 1, cols = 1)
writeData(wb, ws, PROVEEDOR_SUBFAMILIAS_TOTAL_JOYERIA,
startRow = data_start_prov, startCol = 1, borders = "all")
total_rows_ps <- which(PROVEEDOR_SUBFAMILIAS_TOTAL_JOYERIA$SUBFAMILIA == "TOTAL") +
data_start_prov
pct_col_ps    <- which(names(PROVEEDOR_SUBFAMILIAS_TOTAL_JOYERIA) == "Participación")
num_cols_ps   <- which(names(PROVEEDOR_SUBFAMILIAS_TOTAL_JOYERIA) %in%
c("Unidades", "Facturación"))
apply_table_styles(wb, ws, PROVEEDOR_SUBFAMILIAS_TOTAL_JOYERIA,
start_row = data_start_prov, start_col = 1,
total_rows = total_rows_ps,
pct_cols   = pct_col_ps,
num_cols   = num_cols_ps)
