apply_table_styles(wb, ws, ventas_cero_JOYERIA,
start_row = 1, start_col = 1,
num_cols  = num_cols_ssv)
# Escala de color en "STOCK TIENDAS": amarillo claro → naranja
col_st_tiendas <- which(names(ventas_cero_JOYERIA) == "STOCK TIENDAS")
n_ssv          <- nrow(ventas_cero_JOYERIA)
max_st         <- max(ventas_cero_JOYERIA$`STOCK TIENDAS`, na.rm = TRUE)
# conditionalFormatting(wb, ws,
#                        cols = col_st_tiendas, rows = 2:(n_ssv + 1),
#                        style = c("#FFFFFF", "#FFC000", "#E84040"),
#                        type  = "colourScale")
setColWidths(wb, ws, cols = 1:3, widths = 35)
setColWidths(wb, ws, cols = 4:ncol(ventas_cero_JOYERIA), widths = 15)
freezePane(wb, ws, firstActiveRow = 2)
addFilter(wb, ws, row = 1, cols = 1:ncol(ventas_cero_JOYERIA))
nombre_archivo <- paste0("Reporte_ventas/Reporte_Ventas_JOYERIA_", mes, "v2_.xlsx")
saveWorkbook(wb, nombre_archivo, overwrite = TRUE)
message("\u2714 Guardado: ", nombre_archivo)
table(Stock_con_subfamilia_JOYERIA$FAMILIA)
table(Stock_con_subfamilia_JOYERIA$FAMILIA, useNA = "always")
View(Stock_con_subfamilia_JOYERIA)
View(Stock_con_precios_JOYERIA)
Stock_con_subfamilia_JOYERIA <- Stock_JOYERIA |>
left_join(Base_para_stock_JOYERIA, by = "REFERENCIA_INTERNA") |>
filter(FAMILIA %in% c("ANILLOS", "AROS", "CADENAS Y COLLARES", "PULSERAS", "DIJES Y COLGANTES", "TIENTOS") |          str_detect(PRODUCTO, "TIENTO CUERO|COLLAR TUBO CUERO")) %>%
mutate(FAMILIA = if_else(str_detect(PRODUCTO, "TIENTO CUERO"), "TIENTOS", FAMILIA))
#Le agrego los precios desde la lista de precios de Odoo
Precios <- read_excel(paste0("Lista_precios/Lista_precios_", fecha_precios, ".xlsx")) |>
rename(PRODUCTO = "Reglas de lista de precios/Variante", PRECIO_SIN_IMP = "Reglas de lista de precios/Precio fijo") |>
mutate(PRECIO = round(PRECIO_SIN_IMP*1.21)) |>
select(-PRECIO_SIN_IMP)
Stock_con_precios_JOYERIA <- Stock_con_subfamilia_JOYERIA |>
left_join(Precios, by = "PRODUCTO")
REVISAR_STOCK_SIN_PRECIO_JOYERIA <- Stock_con_precios_JOYERIA %>%
filter(is.na(PRECIO)) #para eliminar las filas de productos que no están a la venta
STOCK_TIENDA_JOYERIA <-  Stock_con_precios_JOYERIA %>%
mutate(TOTAL = PRECIO*CANTIDAD) |>
select(FAMILIA, TIENDA, TOTAL) %>%
group_by(FAMILIA, TIENDA) %>%
summarise(VALOR_STOCK = sum(TOTAL, na.rm = TRUE))
#calculo el valor del stock por tienda y depósito
STOCK_VALOR_JOYERIA <- STOCK_TIENDA_JOYERIA %>%
pivot_wider(
id_cols = FAMILIA,    # Columna que irá a las filas
names_from = TIENDA,       # Columna que irá a las columnas
values_from = VALOR_STOCK    # Columna con los valores
)
#agrego totales de columnas y las ordeno
STOCK_VALOR_TOTAL_JOYERIA <- STOCK_VALOR_JOYERIA %>%
adorn_totals(where = "row") %>%
relocate("Florida Depósito", .after = Barracas) %>%
relocate("El Solar", .after = "Güemes 2")
View(STOCK_VALOR_TOTAL_JOYERIA)
#Tabla general proveedor
TABLA_PROVEEDOR <- FACTURAS_MES2_JOYERIA %>%
group_by(PROVEEDOR) %>%
summarise(Unidades = sum(PRODUCTO_CANTIDAD, na.rm = TRUE),
Facturación = round(sum(PRODUCTO_TOTAL, na.rm = TRUE))) %>%
mutate(Participación = round((Facturación / sum(Facturación, na.rm = TRUE)), 4)) %>%
arrange(desc(Facturación))
fila_total_proveedor_JOYERIA <- tibble(
PROVEEDOR = "TOTAL",
Unidades = sum(TABLA_PROVEEDOR$Unidades, na.rm = TRUE),
Facturación = sum(TABLA_PROVEEDOR$Facturación, na.rm = TRUE),
Participación = 1)
PROVEEDOR_JOYERIA_TOTAL <- bind_rows(fila_total_proveedor_JOYERIA, TABLA_PROVEEDOR)
#Tabla de subfamilias entre los proveedores externos
PROVEEDOR_SUBFAMILIAS <- FACTURAS_MES2_JOYERIA %>%
rename(FAMILIA = SUBFAMILIA) %>%
group_by(FAMILIA, PROVEEDOR) %>%
summarise(Unidades = sum(PRODUCTO_CANTIDAD, na.rm = TRUE),
Facturación = round(sum(PRODUCTO_TOTAL, na.rm = TRUE))) %>%
mutate(Participación = round((Facturación / sum(Facturación, na.rm = TRUE)), 4)) %>%
filter(Unidades>0) %>%
arrange(FAMILIA, desc(Facturación))
View(FACTURAS_MES2_JOYERIA)
#Tabla de subfamilias entre los proveedores externos
PROVEEDOR_SUBFAMILIAS <- FACTURAS_MES2_JOYERIA %>%
select(-FAMILIA) %>%
rename(FAMILIA = SUBFAMILIA) %>%
group_by(FAMILIA, PROVEEDOR) %>%
summarise(Unidades = sum(PRODUCTO_CANTIDAD, na.rm = TRUE),
Facturación = round(sum(PRODUCTO_TOTAL, na.rm = TRUE))) %>%
mutate(Participación = round((Facturación / sum(Facturación, na.rm = TRUE)), 4)) %>%
filter(Unidades>0) %>%
arrange(FAMILIA, desc(Facturación))
View(PROVEEDOR_SUBFAMILIAS)
fila_total_proveedor_subfamilia_JOYERIA <- tibble(
FAMILIA = "TOTAL",
Unidades = sum(PROVEEDOR_SUBFAMILIAS$Unidades, na.rm = TRUE),
Facturación = sum(PROVEEDOR_SUBFAMILIAS$Facturación, na.rm = TRUE),
Participación = 1)
PROVEEDOR_SUBFAMILIAS_TOTAL_JOYERIA <- bind_rows(fila_total_proveedor_subfamilia_JOYERIA, PROVEEDOR_SUBFAMILIAS)
View(PROVEEDOR_SUBFAMILIAS_TOTAL_JOYERIA)
#Tabla general proveedor
TABLA_PROVEEDOR <- FACTURAS_MES2_JOYERIA %>%
filter(!is.na(PROVEEDOR)) %>%
group_by(PROVEEDOR) %>%
summarise(Unidades = sum(PRODUCTO_CANTIDAD, na.rm = TRUE),
Facturación = round(sum(PRODUCTO_TOTAL, na.rm = TRUE))) %>%
mutate(Participación = round((Facturación / sum(Facturación, na.rm = TRUE)), 4)) %>%
arrange(desc(Facturación))
View(REVISAR_PROVEEDORES_JOYERIA)
